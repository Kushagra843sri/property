# Copy to .env and fill in. Names only here; never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/property
# Comma-separated exact origins (no wildcard)
CORS_ORIGINS=http://localhost:3000
# Number of reverse-proxy hops in front of the API (must be >0 in production)
TRUST_PROXY=0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_DOMAIN=

# Providers: console/mock work in development only; production refuses to start with them.
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
DEALER_NOTIFY_EMAIL=

SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

IMAGE_PROVIDER=mock
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=properties
